# Environment variables for the Hedera DID anchor spike
# DO NOT commit real credentials — this file is for documentation only.

# Hedera testnet network name. Always "testnet" for development.
HEDERA_NETWORK=testnet

# Your Hedera testnet operator account ID.
# Format: 0.0.XXXXXX
# Get one free at: https://portal.hedera.com
HEDERA_OPERATOR_ID=0.0.REPLACE_ME

# The raw DER-encoded private key for the operator account.
# Starts with: 302e... (Ed25519) or 3030... (ECDSA secp256k1)
# IMPORTANT: This is the ACCOUNT key that pays for transactions — NOT the DID owner key.
# The DID's own key pair is generated fresh by the SDK and saved to .local/private/ (gitignored).
HEDERA_OPERATOR_KEY=REPLACE_ME_WITH_YOUR_DER_PRIVATE_KEY

# How long (ms) to wait for the DID message to be visible via the mirror node.
# Increase to 180000 if you see "not found" on first resolve attempt.
DID_VISIBILITY_TIMEOUT_MS=180000